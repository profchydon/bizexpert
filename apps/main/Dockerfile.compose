FROM node:22 AS build

WORKDIR /app

ENV HUSKY=0
ENV NEXT_TELEMETRY_DISABLED=1

ARG NEXT_PUBLIC_PRODUCT=bizexpert
ARG NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
ENV NEXT_PUBLIC_PRODUCT=$NEXT_PUBLIC_PRODUCT
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

COPY package*.json ./

RUN --mount=type=secret,id=github_token \
  bash -c 'TOKEN="$(tr -d "[:space:]" < /run/secrets/github_token)"; \
    if [ -z "$TOKEN" ]; then echo "GITHUB_TOKEN is empty. Add it to apps/main/.env or the project root .env" >&2; exit 1; fi; \
    printf "%s\n" "legacy-peer-deps=true" "@raydahq:registry=https://npm.pkg.github.com" "//npm.pkg.github.com/:_authToken=${TOKEN}" > .npmrc; \
    npm install --legacy-peer-deps'

COPY . .

RUN npm run build

FROM node:22-alpine AS runtime

WORKDIR /app

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY --from=build --chown=appuser:appgroup /app/.next/static ./.next/static
COPY --from=build --chown=appuser:appgroup /app/.next/standalone ./
COPY --from=build --chown=appuser:appgroup /app/public ./public

USER appuser

ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

CMD ["node", "server.js"]
