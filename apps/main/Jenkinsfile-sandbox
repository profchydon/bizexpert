// Slack helpers
// ---------------------------------------------------------------------------

// Escape a string so it is safe inside a JSON string literal.
def jsonEscape(String s) {
    return s
        .replace('\\', '\\\\')
        .replace('"', '\\"')
        .replace('\n', '\\n')
        .replace('\r', '')
        .replace('\t', '  ')
        .replaceAll('[\\x00-\\x1F]', '')   // any other raw control char is invalid in JSON
}

// Turn raw stage output into text that is safe to drop into a Slack mrkdwn code block
// inside a JSON payload. The section it ends up in is rendered as:
//     <header>\n```<log>```
// so the log is trimmed (keeping the tail, the most relevant part) only by as much as needed
// for the whole section text to fit Slack's 3000 char limit.
def formatLogForSlack(String raw, String header) {
    final int SLACK_SECTION_LIMIT = 3000
    final int SAFETY_MARGIN = 5      // headroom in case Slack adds characters/newlines

    def log = (raw ?: 'Log not available')
        .replaceAll('\\x1B\\[[0-9;?]*[ -/]*[@-~]', '')   // strip ANSI colour/cursor codes
        .replace('&', '&amp;')                          // Slack requires & < > to be entity-escaped
        .replace('<', '&lt;')
        .replace('>', '&gt;')

    int wrapperLength = header.length() + 1 + 3 + 3   // header + "\n" + opening ``` + closing ```
    int totalLength = wrapperLength + log.length()

    if (totalLength > SLACK_SECTION_LIMIT) {
        int cut = (totalLength - SLACK_SECTION_LIMIT) + SAFETY_MARGIN
        log = cut >= log.length() ? '' : log.substring(cut)
    }
    return jsonEscape(log)
}

// Post a payload to the webhook and report the outcome without failing the build.
// Must be called inside withCredentials([... variable: 'SLACK_WEBHOOK']).
def sendSlackPayload(String payload) {
    writeFile file: 'slack_payload.json', text: payload
    def httpCode = sh(
        script: 'curl -sS -o slack_response.txt -w "%{http_code}" -X POST -H "Content-type: application/json" --data @slack_payload.json "${SLACK_WEBHOOK}" || true',
        returnStdout: true
    ).trim()
    def body = fileExists('slack_response.txt') ? readFile('slack_response.txt').trim() : ''

    if (httpCode == '200') {
        echo "✅ Slack notification sent"
    } else {
        echo "⚠️ Slack notification failed (HTTP ${httpCode}): ${body}"
    }
}
