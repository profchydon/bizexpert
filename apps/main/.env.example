# BizExpert: set product mode and Nest API (no trailing slash)
NEXT_PUBLIC_PRODUCT=bizexpert
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Core API base URL (no trailing slash) — Rayda Remote only
NEXT_PUBLIC_CORE_BASE_URL=https://api.example.com

# This app's public URL
NEXT_PUBLIC_APP_URL=https://app.example.com

# Admin app URL (impersonation exit fallback)
NEXT_PUBLIC_ADMIN_APP_URL=https://admin.example.com

# App environment: development | staging | production
# When unset, falls back to NODE_ENV. A production build always sets NODE_ENV to
# "production" regardless of which environment it is deployed to.
NEXT_PUBLIC_APP_ENV=development

# Client-side auth payload encryption key
NEXT_PUBLIC_ENCRYPT_KEY=your_encrypt_key_here

# Google Maps / Places API key
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_api_key_here

# Google Tag Manager container ID
NEXT_PUBLIC_GTMANAGER=GTM-XXXXXXX

# Hotjar site ID
NEXT_PUBLIC_HOTJAR_ID=0000000

# PostHog project API key (client-side)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here

# Optional: upstream PostHog hosts for Next.js /ingest rewrites (server-side only).
# Omit both to use US Cloud defaults. Assets host is derived from ingest unless overridden.
# POSTHOG_INGEST_HOST=https://us.i.posthog.com
# POSTHOG_ASSETS_HOST=https://us-assets.i.posthog.com
